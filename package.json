{
  "name": "flagmint-sdk-tester",
  "version": "1.2.0",
  "private": true,
  "description": "Standalone tool for testing Flagmint SDKs without writing code",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "sync:config-sync": "rsync -a --delete --exclude='*.test.ts' --exclude='*.utest.ts' --exclude='README.md' ../flagmint-js-sdk/sdk/core/config-sync/ src/lib/config-sync/"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "vite": "^8.0.3"
  }
}
